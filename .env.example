# Local development only. On GitHub, set these as Actions *Variables* instead
# (Settings -> Secrets and variables -> Actions -> Variables).

# Google Sheet id (the long string in the sheet URL between /d/ and /edit)
SHEET_ID=

# Public URL of the site (sitemap / social previews)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contact form service URL (Formspree / Web3Forms). Empty = opens the visitor's email app.
NEXT_PUBLIC_FORM_ENDPOINT=

# Only when hosting at user.github.io/REPO (NOT with a custom domain)
NEXT_PUBLIC_BASE_PATH=
